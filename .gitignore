# Patchliner_v0.1 .gitignore (merged from repository root)

# Ignore packaged archives (keep repository small)
*.zip

# macOS
.DS_Store
.AppleDouble
._*
Icon\r
__MACOSX/
.Spotlight-V100
.Trashes

# Editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Swap / backup files
*~
*.swp
*.swo
*.bak
~$*

# Python
__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/
env.bak/
pip-wheel-metadata/
pip-log.txt
.pytest_cache/
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
Thumbs.db
ehthumbs.db

# R
.Rhistory
.RData

# Ignore user-specific or cloud-sync metadata
.DS_Store?
.localized
.goutputstream-
.~lock.*

# Temporary files
*.tmp
*.temp

# Packaging
.egg
.egg-info/

# Ignore environment files commonly used locally
.env
.env.*

# Ignore compiled/shared binaries
*.so
*.dylib

# If you want to ignore node_modules, uncomment below
# node_modules/
